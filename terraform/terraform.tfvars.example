# Example Terraform variables file
# Copy this to terraform.tfvars and customize for your environment

namespace   = "loan-admin"
environment  = "production"

# Application
app_image    = "your-registry.io/loan-admin"
app_version  = "v1.0.0"
app_replicas = 2

# PostgreSQL
postgres_password   = "CHANGE_THIS_SECURE_PASSWORD"
postgres_storage_size = "20Gi"

# Resource Limits
app_memory_request = "512Mi"
app_memory_limit   = "2Gi"
app_cpu_request    = "250m"
app_cpu_limit      = "2000m"

postgres_memory_request = "512Mi"
postgres_memory_limit   = "2Gi"
postgres_cpu_request    = "500m"
postgres_cpu_limit      = "2000m"

# Storage
storage_class_name = "fast-ssd"  # Adjust based on your cluster

# Service
service_type = "LoadBalancer"  # or "ClusterIP" for internal, "NodePort" for bare metal

# Ingress
enable_ingress    = true
ingress_class_name = "nginx"
ingress_host      = "loan-admin.yourdomain.com"
enable_tls        = true
tls_secret_name   = "loan-admin-tls"

# HPA
enable_hpa        = true
hpa_min_replicas  = 2
hpa_max_replicas  = 10
hpa_cpu_target    = 70
hpa_memory_target = 80

# Database Seeding
seed_database = false

