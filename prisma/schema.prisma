// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  seed     = "tsx prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRESQL")
}

// Enhanced models for Proloans-style system
model Company {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique // e.g., "COMP001", "ACME_CORP"
  legalName   String?  // Legal company name
  taxId       String?  // Tax ID / EIN
  address     String?
  city        String?
  state       String?
  country     String   @default("USA")
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  branches    Branch[]
  
  @@map("companies")
}

model Branch {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "BR001", "NYC", "LAX"
  name        String
  companyId   String   // Branch belongs to a company
  company     Company  @relation(fields: [companyId], references: [id])
  address     String?
  city        String?
  state       String?
  country     String   @default("USA")
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  users       User[]
  loans       Loan[]
  payments    Payment[]
  documents   Document[]
  
  @@map("branches")
  @@index([companyId])
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  role              UserRole @default(USER)
  profileImage      String?
  accountNumber     String   @unique
  creditScore       Int?
  creditScoreLastChecked DateTime?
  internalRiskScore Float?
  maxRiskScore      Float?
  averageRate       Float?
  totalBorrowed     Float   @default(0)
  totalRepaid       Float   @default(0)
  memberType        MemberType @default(REGULAR)
  branchId          String? // User's primary branch (null for super admin)
  branch            Branch?  @relation(fields: [branchId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  loans             Loan[]
  payments          Payment[]
  documents         Document[]
  dependents        Dependent[]
  collaterals       Collateral[]
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  monthlySummaries  MonthlySummary[]

  @@map("users")
  @@index([branchId])
}

model Loan {
  id          String      @id @default(cuid())
  loanNumber  String      @unique
  type        LoanType
  amount      Float
  rate        Float
  status      LoanStatus  @default(PENDING)
  startDate   DateTime
  endDate     DateTime?
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  branchId   String      // Loan is associated with a branch
  branch      Branch      @relation(fields: [branchId], references: [id])
  image       String?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("loans")
  @@index([branchId])
  @@index([userId])
}

model Payment {
  id        String   @id @default(cuid())
  amount    Float
  date      DateTime
  type      PaymentType
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  branchId String   // Payment is associated with a branch
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  @@map("payments")
  @@index([branchId])
  @@index([userId])
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      DocumentType
  url       String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  branchId String   // Document is associated with a branch
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  @@map("documents")
  @@index([branchId])
  @@index([userId])
}

model Dependent {
  id        String   @id @default(cuid())
  name      String
  relationship String
  age       Int?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("dependents")
}

model Collateral {
  id          String   @id @default(cuid())
  type        String
  value       Float
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@map("collaterals")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  icon      String
  color     String
  isDefault Boolean  @default(true)
  userId    String?  // If null, it's a system category, otherwise user-created
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  budgets       Budget[]

  @@map("categories")
  @@index([userId])
}

model Transaction {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  amount          Float
  categoryId      Int
  category        Category  @relation(fields: [categoryId], references: [id])
  date            DateTime
  note            String?
  paymentMethod   String?
  location        String?
  isRecurring     Boolean   @default(false)
  recurrenceType  String?   // 'none', 'daily', 'weekly', 'monthly', 'yearly'
  recurringEndDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("transactions")
  @@index([userId])
  @@index([categoryId])
  @@index([date])
}

model Budget {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  categoryId  Int?
  category    Category?   @relation(fields: [categoryId], references: [id])
  amount      Float
  period      BudgetPeriod
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("budgets")
  @@index([userId])
  @@index([categoryId])
}

model MonthlySummary {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  year              Int
  month             Int      // 0-11 (JavaScript month format)
  totalSpent        Float    @default(0)
  categoryBreakdown Json     // Array of { categoryId: number, amount: number }
  updatedAt         DateTime @default(now())

  @@map("monthly_summaries")
  @@index([userId])
  @@index([year, month])
  @@unique([userId, year, month])
}

enum UserRole {
  ADMIN
  USER
  MANAGER
}

enum MemberType {
  REGULAR
  ELITE
  PREMIUM
  VIP
}

enum LoanType {
  HOME_LOAN
  CAR_LOAN
  BUSINESS_LOAN
  PERSONAL_LOAN
  EDUCATION_LOAN
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  PAID
  DEFAULTED
}

enum PaymentType {
  EMI
  LUMP_SUM
  PARTIAL
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  INCOME_PROOF
  BANK_STATEMENT
  LOAN_AGREEMENT
}

enum BudgetPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
