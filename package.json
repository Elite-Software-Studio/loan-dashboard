{
	"name": "loan_admin",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "react-router typegen && tsc",
		"lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "eslint . --ext .ts,.tsx --fix",
		"format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"db:start": "docker compose up -d",
		"db:stop": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:studio": "prisma studio",
		"prisma:reset": "prisma migrate reset",
		"prisma:seed": "prisma db seed",
		"prisma:create-default-branch": "tsx scripts/create-default-branch.ts",
		"k3d:verify": "./scripts/verify-k3d.sh",
		"k3d:setup": "./scripts/setup-k3d.sh",
		"k3d:create": "./scripts/setup-k3d.sh",
		"k3d:teardown": "./scripts/teardown-k3d.sh",
		"k3d:delete": "./scripts/teardown-k3d.sh",
		"k3d:load": "./scripts/load-image.sh loan-admin:latest",
		"k3d:build": "docker build -t loan-admin:latest .",
		"k3d:build-load": "npm run k3d:build && npm run k3d:load",
		"k3d:deploy": "kubectl apply -f k8s/",
		"k3d:status": "kubectl get all -n loan-admin",
		"k3d:logs": "kubectl logs -n loan-admin -l app=loan-admin -f",
		"k3d:logs:postgres": "kubectl logs -n loan-admin -l app=postgres -f",
		"k3d:port-forward": "kubectl port-forward -n loan-admin service/loan-admin-service 3000:80",
		"k3d:full": "npm run k3d:build-load && npm run k3d:deploy && npm run k3d:status"
	},
	"dependencies": {
		"@prisma/client": "^7.2.0",
		"@react-router/node": "^7.7.1",
		"@react-router/serve": "^7.7.1",
		"bcrypt": "^6.0.0",
		"isbot": "^5.1.27",
		"jsonwebtoken": "^9.0.3",
		"prisma": "^7.2.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.7.1",
		"zod": "^4.0.17"
	},
	"devDependencies": {
		"@react-router/dev": "^7.7.1",
		"@tailwindcss/vite": "^4.1.4",
		"@types/bcrypt": "^6.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^20",
		"@types/pg": "^8.15.5",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@vitest/ui": "^2.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-react": "^7.35.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"prettier": "^3.3.0",
		"tailwindcss": "^4.1.4",
		"tsx": "^4.20.4",
		"typescript": "^5.8.3",
		"vite": "^6.3.3",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^2.0.0"
	}
}
